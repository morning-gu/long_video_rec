# 复制为 .env 并填入真实 key（.env 已 gitignore；全部可选，缺省时 LLM 层自动降级）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
TMDB_API_KEY=

# ---- 设备（M8：训练与推理统一 torch device，见 src/device.py）----
# auto（默认，CUDA 可用即用）| cpu | cuda | cuda:0
# REC_DEVICE=auto

# ---- M8 本地 LoRA ranker（scripts/train_lora.py 产出 data/lora-adapter/ 后启用）----
# LLM_RANKER_BACKEND=local
# LORA_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---- 数据集（一般由脚本 --dataset 参数设置，无需在此配置）----
# REC_DATASET=ml-1m
